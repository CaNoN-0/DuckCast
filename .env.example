# PANTA_API_KEY: Panta prediction market API key (pk_test_… or pk_live_…). SERVER-SIDE ONLY.
# Create one via https://docs.panta.market/quickstart (register -> POST /account/keys/).
# Never prefix this with VITE_ — that would ship it in the browser bundle.
PANTA_API_KEY=""

# PANTA_API_BASE: Optional override of the Panta API base URL.
# PANTA_API_BASE="https://live-api.panta.market/api/v1"

# GEMINI_API_KEY: Required for Gemini AI analyst calls (server-side only).
GEMINI_API_KEY=""
# GEMINI_MODEL: Optional model override (default: gemini-3.5-flash)
# GEMINI_MODEL="gemini-3.5-flash"

# VITE_PROJECT_ID: WalletConnect / Reown AppKit Project ID for Solana wallet connection.
# Obtain a free Project ID at https://cloud.reown.com
VITE_PROJECT_ID="your_walletconnect_project_id"

# VITE_SOLANA_RPC_URL: Solana mainnet RPC used for balances and confirmations.
# Panta markets live on Solana mainnet. The public endpoint is heavily rate-limited;
# a free Helius / QuickNode / Alchemy endpoint is strongly recommended for demos.
VITE_SOLANA_RPC_URL="https://api.mainnet-beta.solana.com"
